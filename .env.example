# ── Serveur ──────────────────────────────────────────────────────────────────
HOST=::
PORT=3000
API_PREFIX=/api

# URL publique de base (utilisée pour les liens QR). Laisser vide = détection auto.
PUBLIC_BASE_URL=https://cag.mybusinesslife.fr

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONN_LIMIT=10

# ── Auth JWT ──────────────────────────────────────────────────────────────────
# Génère une valeur aléatoire forte : openssl rand -hex 48
JWT_SECRET=change_me_with_a_strong_random_secret
JWT_EXPIRES=12h

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://mybusinesslife.fr,https://www.mybusinesslife.fr

# ── Rôles & droits ────────────────────────────────────────────────────────────
ENFORCE_ROLES=true
WRITE_ROLES=admin,manager
ALLOW_WRITE_WITHOUT_ROLE=true

# ── Horaires métier (fuseau Algérie = UTC+1) ──────────────────────────────────
# Jour comptable : 12h00 → 03h00 (passe minuit)
BUSINESS_DAY_START_HOUR=12
BUSINESS_DAY_END_HOUR=6
BUSINESS_TIME_OFFSET_MINUTES=60

# ── Auth / sécurité ───────────────────────────────────────────────────────────
AUTH_DB_CHECK=true
AUTH_LOOKUP_TIMEOUT_MS=5000
MIGRATE_PLAINTEXT_PASSWORDS=false
MIGRATE_PLAINTEXT_PASSWORDS_OVERWRITE=false

# ── Debug (désactivé en production) ──────────────────────────────────────────
# Mettre à true uniquement en local pour tester les routes /api/debug/*
ENABLE_DEBUG_ROUTES=false
